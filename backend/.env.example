# --- Core ---
ENVIRONMENT=development            # development | production
# PostgreSQL in production. For quick local runs you may use sqlite:///./jobsentinel_dev.db
DATABASE_URL=postgresql+psycopg://jobsentinel:change-me@localhost:5432/jobsentinel
# Comma-separated list of allowed browser origins (no wildcard in production)
CORS_ORIGINS=http://localhost:5173

# --- Privacy / retention ---
# 0 = never store the submitted job text (default). >0 = keep it this many days, then purge with `python -m app.cli purge`.
INPUT_TEXT_RETENTION_DAYS=0

# --- Limits ---
MAX_TEXT_CHARS=20000
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=30
RATE_LIMIT_PER_MINUTE=20

# --- URL fetching (SSRF-guarded) ---
URL_FETCH_TIMEOUT_SECONDS=8
URL_FETCH_MAX_BYTES=1000000
URL_FETCH_MAX_REDIRECTS=3

# --- Optional integrations (leave blank if you have no key) ---
# Legacy diagnostic-only data.gov.in settings; company verification no longer uses this API.
MCA_API_KEY=
MCA_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a
# MCA_TIMEOUT_SECONDS=6
# Optional DistilBERT directory (needs torch+transformers and fine-tuned weights, none are shipped)
DISTILBERT_MODEL_DIR=

# --- Optional: Adzuna job-board listing cross-check (informational, never scored) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# --- Rate limiting backend: memory (per process) | database (shared across instances) ---
RATE_LIMIT_BACKEND=memory

# TRUSTED_PROXY_COUNT=1   # reverse proxies in front of the API (Render = 1) so the real client IP is read from X-Forwarded-For
# MCA_TIMEOUT_SECONDS=6
# ADZUNA_TIMEOUT_SECONDS=6
# MODEL_ARTIFACT_DIR=./ml/artifacts   # must contain model_metadata.json whose SHA-256 values match the .pkl files
# Use Adzuna advertised-salary percentiles for the salary check when ADZUNA_* are set (job title is sent to Adzuna). false = use the unsourced table.
ADZUNA_SALARY_BENCHMARKS=true
